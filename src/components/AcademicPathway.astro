---
/**
 * The Guided Ascent pathway: four stages climbing left-to-bottom to
 * right-to-top, connected by a thin red line drawn on scroll (GSAP).
 * Fully readable without JavaScript — the line is simply already drawn.
 */
import { academicStages } from "../data/school";

interface Props {
  /** Show an admission CTA under each stage (used on /academics). */
  withCtas?: boolean;
}
const { withCtas = false } = Astro.props;
---

<div class="pathway" data-ascent-scope>
  <svg
    class="pathway__line"
    viewBox="0 0 4 400"
    preserveAspectRatio="none"
    aria-hidden="true"
  >
    <path data-ascent-path d="M2 0 L2 400" stroke="#B21F2D" stroke-width="3" fill="none"></path>
  </svg>
  <ol class="pathway__list">
    {
      academicStages.map((stage, i) => (
        <li class="pathway__stage" data-reveal>
          <div class="pathway__marker" aria-hidden="true">
            {i + 1}
          </div>
          <div class="pathway__body">
            <p class="pathway__range">{stage.range}</p>
            <h3>{stage.title}</h3>
            <p class="pathway__note">{stage.note}</p>
            {"streams" in stage && (
              <ul class="pathway__streams" aria-label="Higher Secondary streams">
                {stage.streams.map((s) => (
                  <li>{s}</li>
                ))}
              </ul>
            )}
            {withCtas && (
              <a class="btn btn--quiet" href="/admissions">
                Enquire about {stage.range} →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .pathway {
    position: relative;
    padding-left: 1rem;
  }
  .pathway__line {
    position: absolute;
    left: calc(1rem + 21px);
    top: 12px;
    bottom: 12px;
    width: 4px;
    height: calc(100% - 24px);
  }
  .pathway__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
  }
  .pathway__stage {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }
  .pathway__marker {
    flex: none;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--paper);
    border: 3px solid var(--red);
    border-radius: 50%;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--red);
    position: relative;
    z-index: 1;
  }
  .pathway__stage:last-child .pathway__marker {
    background: var(--red);
    color: #fff;
  }
  .pathway__range {
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
    margin-bottom: 0.25rem;
  }
  .pathway__body h3 {
    margin-bottom: 0.25rem;
  }
  .pathway__note {
    color: var(--ink-muted);
    margin-bottom: 0.5rem;
  }
  .pathway__streams {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: flex;
    gap: 0.5rem;
  }
  .pathway__streams li {
    padding: 0.35rem 0.9rem;
    background: var(--red-tint);
    color: var(--red-deep);
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.9375rem;
  }
</style>
